{
  "name": "libradigit-ai",
  "version": "1.2.0",
  "description": "AI-Based Digitization & Digital Archive Builder for Libraries with Advanced OCR and Handwritten Text Recognition",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && python server.py",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "ocr",
    "advanced-ocr",
    "handwriting-recognition",
    "digitization",
    "library",
    "archive",
    "electron",
    "ai",
    "machine-learning",
    "pdf-generation",
    "document-processing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.294.0",
    "pdfjs-dist": "^5.4.530",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.3.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.libradigit.ai",
    "productName": "LibraDigit AI",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/server",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}