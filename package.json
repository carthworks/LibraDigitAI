{
  "name": "libradigit-ai",
  "version": "1.3.0",
  "type": "module",
  "description": "AI-Based Digitization & Digital Archive Builder for Libraries with Advanced OCR and Handwritten Text Recognition",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && python server.py",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --win",
    "pack": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --win --dir",
    "lint": "eslint .",
    "test:backend": "cd backend && python -m pytest tests -q",
    "build:backend": "cd backend && pyinstaller --noconfirm server.spec",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "ocr",
    "advanced-ocr",
    "handwriting-recognition",
    "digitization",
    "library",
    "archive",
    "electron",
    "ai",
    "machine-learning",
    "pdf-generation",
    "document-processing"
  ],
  "author": "Carthworks",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "dompurify": "^3.3.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.294.0",
    "pdfjs-dist": "5.4.296",
    "postcss": "^8.5.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.3.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-elevation": "^2.0.0",
    "tailwindcss-fluid-type": "^2.0.7",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.libradigit.ai",
    "productName": "LibraDigit AI",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/tesseract",
        "to": "tesseract",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "LibraDigit-AI-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "carthworks",
        "repo": "LibraDigitAI"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/carthworks/LibraDigitAI.git"
  }
}
