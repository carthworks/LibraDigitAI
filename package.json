{
  "name": "libradigit-ai",
  "version": "1.2.0",
  "type": "module",
  "description": "AI-Based Digitization & Digital Archive Builder for Libraries with Advanced OCR and Handwritten Text Recognition",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && python server.py",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "cross-env ELECTRON_BUILD=true npm run build && electron-builder",
    "pack": "cross-env ELECTRON_BUILD=true npm run build && electron-builder --dir"
  },
  "keywords": [
    "ocr",
    "advanced-ocr",
    "handwriting-recognition",
    "digitization",
    "library",
    "archive",
    "electron",
    "ai",
    "machine-learning",
    "pdf-generation",
    "document-processing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.3.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.294.0",
    "pdfjs-dist": "5.4.296",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.3.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.0",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-elevation": "^2.0.0",
    "tailwindcss-fluid-type": "^2.0.7",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.libradigit.ai",
    "productName": "LibraDigit AI",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/server",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
